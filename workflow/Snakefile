# SNV & INDELS
# Override BAM input to use snv_aligner (pbmm2) instead of the primary aligner
# (vacmap). DeepSomatic and ClairS-TO are not compatible with vacmap BAMs.
use rule clairs_to_call from snv_indels as snv_indels_clairs_to_call with:
    input:
        bam=lambda wildcards: get_input_aligned_bam(wildcards, _snv_config)[0],
        bai=lambda wildcards: get_input_aligned_bam(wildcards, _snv_config)[1],
        ref=config.get("reference", {}).get("fasta", ""),
        bed=config.get("reference", {}).get("design_bed", ""),


use rule clairs_to_concat from snv_indels as snv_indels_clairs_to_concat with:
    output:
        vcf=temp("snv_indels/clairs_to/{sample}_{type}.vcf.gz"),


# SNV & INDELS from DeepSomatic-TO
# Override BAM input to use snv_aligner (pbmm2) — see clairs_to_call note above.
use rule deepsomatic_t_only from snv_indels as snv_indels_deepsomatic_t_only with:
    wildcard_constraints:
        type="T",
    input:
        bam=lambda wildcards: get_input_aligned_bam(wildcards, _snv_config)[0],
        bai=lambda wildcards: get_input_aligned_bam(wildcards, _snv_config)[1],
        ref=config.get("reference", {}).get("fasta", ""),
        bed=config.get("reference", {}).get("design_bed", ""),


# When use_deepsomatic is true both callers run.
# Each VCF is tagged with a CALLER INFO field, then they are concatenated and
# sorted so that the merged file can flow through the shared downstream pipeline.


rule snv_indels_clairs_to_add_caller_tag:
    """Add CALLER=clairs_to to the INFO field of every ClairS-TO record."""
    input:
        vcf="snv_indels/clairs_to/{sample}_{type}.vcf.gz",
    output:
        vcf=temp("snv_indels/clairs_to/{sample}_{type}.caller_tagged.vcf.gz"),
        tbi=temp("snv_indels/clairs_to/{sample}_{type}.caller_tagged.vcf.gz.tbi"),
    params:
        caller="clairs_to",
    log:
        "snv_indels/clairs_to/{sample}_{type}.caller_tagged.vcf.gz.log",
    threads: config.get("bcftools_annotate_caller_tag", {}).get("threads", config["default_resources"]["threads"])
    resources:
        mem_mb=config.get("bcftools_annotate_caller_tag", {}).get("mem_mb", config["default_resources"]["mem_mb"]),
        mem_per_cpu=config.get("bcftools_annotate_caller_tag", {}).get("mem_per_cpu", config["default_resources"]["mem_per_cpu"]),
        partition=config.get("bcftools_annotate_caller_tag", {}).get("partition", config["default_resources"]["partition"]),
        threads=config.get("bcftools_annotate_caller_tag", {}).get("threads", config["default_resources"]["threads"]),
        time=config.get("bcftools_annotate_caller_tag", {}).get("time", config["default_resources"]["time"]),
    container:
        config.get("bcftools_annotate_caller_tag", {}).get("container", config["default_container"])
    message:
        "{rule}: tagging ClairS-TO VCF with CALLER info for {wildcards.sample}_{wildcards.type}"
    shell:
        """
        (
          printf '##INFO=<ID=CALLER,Number=1,Type=String,Description="Variant caller">\n' | \
          bcftools annotate --header-lines /dev/stdin {input.vcf} | \
          awk 'BEGIN{{OFS="\\t"}} /^#/{{print; next}} \
               {{if ($8 == ".") $8="CALLER={params.caller}"; \
                 else $8="CALLER={params.caller};"$8; print}}' | \
          bgzip -c > {output.vcf}
          tabix {output.vcf}
        ) 2> {log}
        """


rule snv_indels_deepsomatic_add_caller_tag:
    """Add CALLER=deepsomatic to the INFO field of every DeepSomatic record."""
    wildcard_constraints:
        type="T",
    input:
        vcf="snv_indels/deepsomatic_t_only/{sample}_{type}.vcf.gz",
    output:
        vcf=temp("snv_indels/deepsomatic_t_only/{sample}_{type}.caller_tagged.vcf.gz"),
        tbi=temp("snv_indels/deepsomatic_t_only/{sample}_{type}.caller_tagged.vcf.gz.tbi"),
    params:
        caller="deepsomatic",
    log:
        "snv_indels/deepsomatic_t_only/{sample}_{type}.caller_tagged.vcf.gz.log",
    threads: config.get("bcftools_annotate_caller_tag", {}).get("threads", config["default_resources"]["threads"])
    resources:
        mem_mb=config.get("bcftools_annotate_caller_tag", {}).get("mem_mb", config["default_resources"]["mem_mb"]),
        mem_per_cpu=config.get("bcftools_annotate_caller_tag", {}).get("mem_per_cpu", config["default_resources"]["mem_per_cpu"]),
        partition=config.get("bcftools_annotate_caller_tag", {}).get("partition", config["default_resources"]["partition"]),
        threads=config.get("bcftools_annotate_caller_tag", {}).get("threads", config["default_resources"]["threads"]),
        time=config.get("bcftools_annotate_caller_tag", {}).get("time", config["default_resources"]["time"]),
    container:
        config.get("bcftools_annotate_caller_tag", {}).get("container", config["default_container"])
    message:
        "{rule}: tagging DeepSomatic VCF with CALLER info for {wildcards.sample}_{wildcards.type}"
    shell:
        """
        (
          printf '##INFO=<ID=CALLER,Number=1,Type=String,Description="Variant caller">\n' | \
          bcftools annotate --header-lines /dev/stdin {input.vcf} | \
          awk 'BEGIN{{OFS="\\t"}} /^#/{{print; next}} \
               {{if ($8 == ".") $8="CALLER={params.caller}"; \
                 else $8="CALLER={params.caller};"$8; print}}' | \
          bgzip -c > {output.vcf}
          tabix {output.vcf}
        ) 2> {log}
        """


rule snv_indels_bcftools_concat_callers:
    """Concatenate ClairS-TO and DeepSomatic caller-tagged VCFs into a single sorted VCF.
    -a allows overlapping positions (same variant called by both callers) and requires
    tabix-indexed inputs.
    """
    input:
        vcfs=get_concat_caller_vcfs,
        tbis=lambda wildcards: [f"{v}.tbi" for v in get_concat_caller_vcfs(wildcards)],
    output:
        vcf=temp("snv_indels/snv_concat/{sample}_{type}.vcf.gz"),
        tbi=temp("snv_indels/snv_concat/{sample}_{type}.vcf.gz.tbi"),
    log:
        "snv_indels/snv_concat/{sample}_{type}.vcf.gz.log",
    threads: config.get("bcftools_concat_callers", {}).get("threads", config["default_resources"]["threads"])
    resources:
        mem_mb=config.get("bcftools_concat_callers", {}).get("mem_mb", config["default_resources"]["mem_mb"]),
        mem_per_cpu=config.get("bcftools_concat_callers", {}).get("mem_per_cpu", config["default_resources"]["mem_per_cpu"]),
        partition=config.get("bcftools_concat_callers", {}).get("partition", config["default_resources"]["partition"]),
        threads=config.get("bcftools_concat_callers", {}).get("threads", config["default_resources"]["threads"]),
        time=config.get("bcftools_concat_callers", {}).get("time", config["default_resources"]["time"]),
    container:
        config.get("bcftools_concat_callers", {}).get("container", config["default_container"])
    message:
        "{rule}: merging ClairS-TO and DeepSomatic VCFs for {wildcards.sample}_{wildcards.type}"
    shell:
        """
        (
          tmpdir=$(mktemp -d)
          trap "rm -rf $tmpdir" EXIT
          echo "{wildcards.sample}" > $tmpdir/samples.txt
          bcftools reheader -s $tmpdir/samples.txt {input.vcfs[0]} -o $tmpdir/vcf0.vcf.gz
          tabix $tmpdir/vcf0.vcf.gz
          bcftools reheader -s $tmpdir/samples.txt {input.vcfs[1]} -o $tmpdir/vcf1.vcf.gz
          tabix $tmpdir/vcf1.vcf.gz
          bcftools concat -a $tmpdir/vcf0.vcf.gz $tmpdir/vcf1.vcf.gz | \
          bcftools norm -m- | \
          bcftools sort -O z -o {output.vcf}
          tabix {output.vcf}
        ) 2> {log}
        """


# fix AF entries
# Local script overrides the module's fix_af.py to add snv_concat as a valid
# caller (the concat of clairs_to + deepsomatic VCFs), treated identically to
# clairs_to: FORMAT/AF is propagated to INFO/AF with no transformation.
rule fix_af:
    input:
        vcf=get_snv_caller_output,
    output:
        vcf=temp("snv_indels/fix_af/{sample}_{type}.vcf"),
    log:
        "snv_indels/fix_af/{sample}_{type}.vcf.log",
    benchmark:
        repeat(
            "snv_indels/fix_af/{sample}_{type}.vcf.benchmark.tsv",
            config.get("fix_af", {}).get("benchmark_repeats", 1),
        )
    threads: config.get("fix_af", {}).get("threads", config["default_resources"]["threads"])
    resources:
        mem_mb=config.get("fix_af", {}).get("mem_mb", config["default_resources"]["mem_mb"]),
        mem_per_cpu=config.get("fix_af", {}).get("mem_per_cpu", config["default_resources"]["mem_per_cpu"]),
        partition=config.get("fix_af", {}).get("partition", config["default_resources"]["partition"]),
        threads=config.get("fix_af", {}).get("threads", config["default_resources"]["threads"]),
        time=config.get("fix_af", {}).get("time", config["default_resources"]["time"]),
    container:
        config.get("fix_af", {}).get("container", config["default_container"])
    message:
        "{rule}: fix missing allele frequency field in format column in {input.vcf}"
    script:
        "scripts/fix_af.py"


